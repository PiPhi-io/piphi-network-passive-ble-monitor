{
  "catalog_version": "1.0",
  "integration_id": "piphi-network-passive-ble-monitor",
  "coverage_mode": "advertisement_format_and_device_negotiation",
  "reviewed_at": "2026-09-07",
  "sources": {
    "ble_monitor": "https://github.com/custom-components/ble_monitor",
    "supported_devices": "https://custom-components.github.io/ble_monitor/devices",
    "bthome": "https://bthome.io/format/",
    "ble_gateway": "PiPhi managed BLE gateway sidecar contract",
    "core_vocabulary": "PiPhi Network Core and maintained PiPhi integrations"
  },
  "groups": [
    {
      "id": "runtime-foundation",
      "status": "implemented",
      "scope": ["all-configurations"],
      "source_refs": ["core_vocabulary"],
      "reason": "Configuration and the refresh route are available. A real BLE observation, not configuration alone, sets connected=true; Core container deployment still requires a reviewed BlueZ access path.",
      "state": ["connected"],
      "events": ["runtime.config.applied"],
      "conditions": ["state_matches"],
      "actions": ["refresh"]
    },
    {
      "id": "bthome-v2-core-measurements",
      "status": "implemented",
      "scope": ["unencrypted-bthome-v2-advertisements-with-supported-object-ids"],
      "source_refs": ["bthome", "ble_monitor"],
      "reason": "The runtime validates and decodes BTHome v2 battery, temperature, and humidity object IDs, captures bounded RSSI from Bleak, filters observations to the configured address, and publishes normalized telemetry.",
      "state": ["temperature_c", "humidity_percent", "battery_percent", "rssi_dbm"],
      "events": [],
      "conditions": [],
      "actions": []
    },
    {
      "id": "environmental-measurements",
      "status": "planned",
      "scope": ["decoded-advertisements-with-matching-measurements"],
      "source_refs": ["ble_monitor", "supported_devices", "bthome"],
      "reason": "These additional environmental object IDs still need decoder support, normalization, fixtures, and widget treatment before they can be advertised.",
      "state": ["dew_point_c", "pressure_hpa", "illuminance_lux", "moisture_percent", "conductivity_us_cm", "co2_ppm", "carbon_monoxide_ppm", "voc_ppb", "pm25_ugm3", "pm10_ugm3", "formaldehyde_mgm3", "air_quality_index", "sound_level_db", "voltage_v", "power_w", "energy_kwh"],
      "events": ["environment.measurement_changed", "environment.threshold_crossed"],
      "conditions": ["temperature_threshold", "humidity_threshold", "pressure_threshold", "illuminance_threshold", "moisture_threshold", "air_quality_threshold", "power_threshold", "energy_threshold"],
      "actions": []
    },
    {
      "id": "battery-radio-and-health",
      "status": "planned",
      "scope": ["all-decoded-devices"],
      "source_refs": ["ble_monitor", "ble_gateway"],
      "reason": "The remaining battery, radio, and diagnostic fields need decoder support or an approved managed gateway contract; trigger-based freshness remains internal runtime behavior rather than a public capability.",
      "state": ["battery_voltage_v", "battery_low", "battery_charging", "tx_power_dbm", "packet_count", "last_seen_at", "advertisement_stale", "decoder_errors", "encrypted_payload", "gateway_id"],
      "events": ["battery.low", "battery.charging_changed", "device.seen", "device.stale", "device.online", "device.offline", "decoder.error"],
      "conditions": ["battery_below", "signal_below", "last_seen_age_threshold", "advertisement_is_stale", "decoder_is_healthy"],
      "actions": []
    },
    {
      "id": "binary-sensors",
      "status": "planned",
      "scope": ["advertisements-with-binary-measurements"],
      "source_refs": ["ble_monitor", "bthome"],
      "reason": "Binary classes are negotiated from decoded packet fields and emit transitions only after a baseline.",
      "state": ["contact_open", "garage_door_open", "motion_detected", "moving", "occupancy_detected", "presence_detected", "leak_detected", "smoke_alarm", "gas_alarm", "carbon_monoxide_alarm", "tamper_detected", "vibration_detected", "light_detected", "sound_detected", "cold_detected", "heat_detected", "lock_locked", "plug_connected", "problem_detected", "running", "safety_alarm"],
      "events": ["contact.changed", "motion.detected", "occupancy.changed", "presence.changed", "leak.detected", "smoke.detected", "gas.detected", "carbon_monoxide.detected", "tamper.detected", "vibration.detected", "button.pressed", "dimmer.rotated"],
      "conditions": ["contact_is_open", "motion_is_detected", "occupancy_is_detected", "presence_is_detected", "alarm_is_active", "tamper_is_detected", "lock_is_locked", "problem_is_detected"],
      "actions": []
    },
    {
      "id": "scales-counters-and-physical-values",
      "status": "planned",
      "scope": ["scales", "meters", "counters", "plant-sensors", "bthome-physical-measurements"],
      "source_refs": ["ble_monitor", "bthome"],
      "reason": "Stabilized and instantaneous measurements require distinct capabilities and decoder-specific range checks.",
      "state": ["weight_kg", "weight_stabilized", "impedance_ohm", "heart_rate_bpm", "volume_l", "mass_storage_kg", "distance_m", "duration_s", "rotation_degrees", "rotation_count", "button_event", "dimmer_steps", "dimmer_direction"],
      "events": ["weight.stabilized", "measurement.reset", "counter.changed"],
      "conditions": ["weight_threshold", "impedance_threshold", "heart_rate_threshold", "volume_threshold", "counter_threshold"],
      "actions": []
    },
    {
      "id": "unsafe-or-out-of-bound-operations",
      "status": "excluded",
      "scope": ["all-devices"],
      "source_refs": ["ble_monitor", "ble_gateway"],
      "reason": "This integration is passive; adapter ownership belongs to the sidecar and raw data or keys must not leak into state or behaviors.",
      "state": ["raw_advertisement_payload", "encryption_key"],
      "events": [],
      "conditions": [],
      "actions": ["write_gatt_characteristic", "connect_active_ble_session", "restart_host_bluetooth", "parse_arbitrary_untrusted_payload"]
    }
  ]
}
